# Kopieren nach .env (auf dem Server, nie committen) und ausfüllen.
# Zufallswerte erzeugen mit:  openssl rand -hex 32

# Domain in Punycode (api.königsdorf-rückt-zusammen.de):
DIRECTUS_DOMAIN=api.xn--knigsdorf-rckt-zusammen-7kc4n.de

DIRECTUS_SECRET=
DB_PASSWORD=

# Dein Admin-Login (nur beim ersten Start gebraucht, Passwort danach im Passwortmanager)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Directus-Lizenz (Open Innovation Grant), leer = Core-Tier
LICENSE_KEY=
